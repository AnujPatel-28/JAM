VITE_INSFORGE_URL=https://<your-app-key>.<region>.insforge.app
# BROWSER key: anon_… (RLS-enforced). NEVER put an ik_… API key here — it bypasses RLS.
VITE_INSFORGE_ANON_KEY=anon_your_anon_key
# Test-only (never commit real values; scripts fail fast without them):
# INSFORGE_SERVICE_KEY=<service-role-key-for-relay-test-only>
# TEST_ROOM_ID=<existing-room-uuid-for-relay-test-only>
# Bot protection (Cloudflare Turnstile; optional — modals skip widget when unset):
# VITE_TURNSTILE_SITE_KEY=<turnstile-site-key-public>
# VITE_FUNCTIONS_URL=https://<your-app-key>.<region>.insforge.app/functions
# Server-only (function env, never VITE_): TURNSTILE_SECRET_KEY, APP_ORIGIN, CLEANUP_TOKEN
# 022: edge functions prefer INSFORGE_SERVICE_KEY (ik_… service key, RLS-bypass
# by design). ADMIN_API_KEY still works as a legacy fallback for cleanup-chat.
# INSFORGE_SERVICE_KEY=<service-key-for-edge-functions-only>
